PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-change-in-production-min32chars
JWT_EXPIRES_IN=1d

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=creatorhub_dev
DB_USER=creatorhub_user
DB_PASSWORD=creatorhub_pass
DB_LOGGING=false

# Network, CORS & Security
CORS_ORIGIN=*
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

# Storage Driver (fake in development/test, cloudinary in production)
STORAGE_DRIVER=fake
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media Quotas & Limits (bytes)
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VIDEO_BYTES=52428800
AVATAR_MAX_BYTES=2097152
MEDIA_MAX_PER_POST=5
MEDIA_QUOTA_BYTES_PER_CREATOR=209715200
