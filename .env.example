PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-change-in-production-min32chars
JWT_EXPIRES_IN=1d

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=creatorhub_dev
DB_USER=creatorhub_user
DB_PASSWORD=creatorhub_pass
DB_LOGGING=false

# Network, CORS & Security
CORS_ORIGIN=*
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

# Storage Driver (fake in development/test, cloudinary in production)
STORAGE_DRIVER=fake
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media Quotas & Limits (bytes)
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VIDEO_BYTES=52428800
AVATAR_MAX_BYTES=2097152
MEDIA_MAX_PER_POST=5
MEDIA_QUOTA_BYTES_PER_CREATOR=209715200

# Email Driver (log in dev/test, smtp in production)
MAIL_DRIVER=log
MAIL_FROM="CreatorHub <no-reply@creatorhub.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# App & Token Base URLs (v0.7)
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
EMAIL_TOKEN_SECRET=super-secret-email-token-key-change-in-prod-min32

# Email Outbox Worker & Rate Limits (v0.7)
JOBS_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=5000
EMAIL_BATCH_SIZE=20
EMAIL_MAX_PER_MINUTE=60
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAYS_SECONDS=60,300,1800,7200
EMAIL_MAX_PER_RECIPIENT_PER_DAY=20
EMAIL_OUTBOX_RETENTION_DAYS=30

# Weekly Digest Schedule (v0.7)
DIGEST_CRON="0 9 * * 1"
DIGEST_TIMEZONE=UTC
DIGEST_LOOKBACK_DAYS=7
DIGEST_MAX_POSTS=20

# Firebase Realtime Database (fake in dev/test, firebase in production, off to disable)
FIREBASE_DRIVER=fake
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SYNC_DEBOUNCE_MS=500
FIREBASE_RECONCILE_CRON="0 * * * *"

# Test & Production Readiness (v0.8)
DB_NAME_TEST=creatorhub_test
DEPLOY_VERIFY_TOKEN=
RUN_MIGRATIONS=false
ALLOW_DEMO_SEED=false
APP_VERSION=1.0.0
APP_COMMIT=unknown
APP_BUILT_AT=unknown
LOG_LEVEL=info

# Analytics, Trending & Frontend (v1.0)
ANALYTICS_HASH_SECRET=super-secret-analytics-hash-key-change-in-prod-min32
ROLLUP_CRON="15 2 * * *"
TRENDING_CRON="*/15 * * * *"
TRENDING_WINDOW_DAYS=30
TRENDING_MAX_ITEMS=50
TRENDING_WEIGHT_VIEWS=1
TRENDING_WEIGHT_COMMENTS=2
TRENDING_WEIGHT_LIKES=3
TRENDING_GRAVITY=1.5
SERVE_WEB=false
CSP_CONNECT_EXTRA=
CSP_IMG_EXTRA=
DEMO_RESET_CONFIRM=

