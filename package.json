{
  "name": "creatorhub-api",
  "version": "0.1.0",
  "description": "Creator Economy Platform API - v0.1 Skeleton & Auth",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "node scripts/db-create.js",
    "db:drop": "node scripts/db-drop.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo:all",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:reference": "npx sequelize-cli db:seed --seed 20261028000001-seed-tiers.js",
    "db:seed:demo": "node scripts/seed-demo.js",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:handles": "jest --detectOpenHandles --runInBand",
    "test:e2e": "node scripts/verify-all.js",
    "smoke": "node scripts/smoke-test.js",
    "check": "npm run lint && npm run format:check && npm run test:unit",
    "ci": "npm run lint && npm run format:check && npm run test:coverage",
    "verify:paywall": "node scripts/verify-paywall.js",
    "verify:associations": "node scripts/verify-associations.js",
    "verify:realtime": "node scripts/verify-realtime.js",
    "verify:graphql": "node scripts/verify-graphql.js",
    "verify:media": "node scripts/verify-media.js",
    "verify:security": "node scripts/verify-security.js",
    "verify:all": "node scripts/verify-all.js",
    "sanitize:backfill": "node scripts/sanitize-backfill.js",
    "verify:email": "node scripts/verify-email.js",
    "verify:firebase": "node scripts/verify-firebase.js",
    "digest:run": "node scripts/digest-run.js",
    "email:status": "node scripts/email-status.js",
    "firebase:resync": "node scripts/firebase-resync.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^16.5.4",
    "firebase-admin": "^14.5.0",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "sanitize-html": "^2.13.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20.18.0 <23.0.0"
  }
}
